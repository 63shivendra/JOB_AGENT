{
  "manifest_version": 3,
  "name": "Job Authenticity Agent",
  "version": "1.0.0",
  "description": "Automatically rates job posts using an LLM scoring engine and saves listings to an analytics dashboard.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.naukri.com/*",
    "*://*.glassdoor.com/*",
    "*://*.internshala.com/*"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.naukri.com/*",
        "*://*.glassdoor.com/*",
        "*://*.internshala.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Authenticity Agent"
  }
}
